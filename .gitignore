# ---- Build output ----
/.build/
/build/

# ---- Fetched at setup time (NOT committed) ----
# Prebuilt whisper.cpp framework — scripts/fetch-whisper.sh (~184 MB)
/Vendor/whisper.xcframework/
/Vendor/*.zip
# Speech model — scripts/fetch-model.sh (~1.6 GB); lives in Application Support
*.bin

# ---- Generated at runtime ----
# ChimeSynth renders its voice-switch cues to disk
*.wav

# ---- Documentation media ----
# Heavy ProRes/QuickTime editing masters — regenerable via
# scripts/render-recording.sh. Only the light web assets (.apng/.webm/.png)
# are committed.
/docs/recordings/*.mov

# ---- macOS / editor cruft ----
.DS_Store
*.swp
.idea/
.vscode/

# ---- SwiftPM local state ----
.swiftpm/
