# ---- Build output ----
/.build/
/build/
# Release archives from scripts/package-release.sh — they belong on the
# release page, not in the history.
/dist/

# The whisper.cpp framework (~184 MB) is fetched and checksum-verified by
# SwiftPM from the binaryTarget in Package.swift, into .build/artifacts/.
# The speech model (~1.6 GB) is fetched by scripts/fetch-model.sh into
# ~/Library/Application Support/Shout/models/ — neither lives in the repo.

# ---- Documentation media ----
# Heavy ProRes/QuickTime editing masters — regenerable via
# scripts/render-recording.sh. Only the light web assets (.apng/.webm/.png)
# are committed.
/docs/recordings/*.mov

# ---- Never commit signing material ----
# scripts/make-signing-cert.sh generates a local identity via mktemp, so nothing
# should land here — these are a backstop, not a workaround.
*.p12
*.pem
*.cer
*.mobileprovision

# ---- macOS / editor cruft ----
.DS_Store
*.swp
.idea/
.vscode/

# ---- SwiftPM local state ----
.swiftpm/
