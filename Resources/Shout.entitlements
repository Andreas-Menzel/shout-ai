<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shout is deliberately NOT sandboxed: it needs a global CGEvent tap, the
	     Accessibility API, and Apple-event control of other apps, none of which
	     the App Sandbox permits. These entitlements only relax the hardened
	     runtime's default restrictions to the minimum Shout actually uses. -->

	<!-- Under the hardened runtime, sending Apple events to other apps (pausing
	     Spotify / Apple Music around a dictation) is blocked unless this is set.
	     Recipients are still subject to the normal TCC Automation consent. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!-- The hardened runtime enforces Library Validation: it refuses to load any
	     framework not signed by the SAME Team ID as the app (or by Apple). The
	     bundled whisper.framework is signed with our self-signed "Shout Dev
	     Signing" cert, which carries no Team ID, so validation has nothing to
	     match on and dyld aborts at launch ("Library not loaded ... different
	     Team IDs"). This opts out of that check so the app can load its own
	     embedded framework. Notarization-safe. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
